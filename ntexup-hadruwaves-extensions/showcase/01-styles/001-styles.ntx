alternativeLocalThemeRepository:= "$HOME/xprojects/nuts-world/nuts-productivity/ntexup/ntexup-templates"
alternativeRemoteThemeRepository:= "github://thevpc/ntexup-templates"
include(
    eitherPath(
        "$alternativeLocalThemeRepository/${themeName}/v1.0/theme"
        "$alternativeRemoteThemeRepository/${themeName}/v1.0/theme"
    )
)

@define miniPage{
    group(background-color: either(documentSurface, white), draw-contour, line-color: either(documentLine, Gray89)){
        slot
    }
}

@define miniCode{
    group(background-color: either(documentSurfaceAlt, Gray89), draw-contour, line-color: either(documentLine, Gray80), margin: 5, padding: 0.5%P){
        slot
    }
}

@define miniCodeNTexup(code){
    group(/*background-color:black,draw-contour,*/margin:5,padding:0.5%P){
        source(ntexup, code,font-size:2%P,at:top-left)
    }
}
