agenda-slide(title:"Yagi-Uda"){
    body{
        grid((2,2)){
            styles:{
                "*": {margin:1.2}
            }
            yagi-uda()                                       // 5 elements
            yagi-uda(directors:1 show:"all")                 // 3 elements
            yagi-uda(view:"top" show:"waves,rays,pattern,labels" directors:5)
            yagi-uda(lengths:"0.49,0.47,0.44" positions:"-0.15,0,0.15")
        }
    }
}
