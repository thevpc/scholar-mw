// --------------------------------------------------
// Antenna parameters (Upper 6 GHz Band: 6.425–7.125 GHz, f0 ~ 6.80 GHz)
// Quarter-Wave Transformer Matched Notchless Rectangular Patch
// --------------------------------------------------

f  = 6.800GHz
εr = 4.4
tanδ = 0.02
h  = 1.6mm      // substrate height
h0 = 0.035mm    // copper thickness

W  = 13.5mm     // patch width (X: -6.75 to 6.75)
L  = 9.40mm     // patch length (Y: 0 to 9.40)

wf = 3.1mm      // 50-ohm feed width (Z0 = 50 ohm)
Lf = 4.7mm      // 50-ohm feed length

wt = 0.70mm     // quarter-wave transformer width (Zt ~ 100 ohm)
Lt = 6.30mm     // quarter-wave transformer length (~ lambda_g / 4)

// Fringing field extension for patch radiating edges
delta_l = 0.72mm

// Simulation domain
box_w = 26mm    // X: -13 to 13
box_l = 26mm    // Y: -11 to 15

feed_y_start = -(Lt + Lf) // -11.0mm
port_y_start = feed_y_start

content-slide(title:"Upper 6 GHz Quarter-Wave Matched Patch Geometry"){
    body{

    styles:{
            text:{ color:darkBlue; font-size:1%P }
            line:{ color:darkBlue; width:2; arrow:simple(); label-bold:true; label-font-size:2%P; label-offset:(50, 1%P, 0) }
            class-substrate:{ bg:gray80, opacity: 0.6 }
            class-ground:{ bg:"#cb6d51", line-color:"#cb6d51" }
            class-antenna:{ bg:"#cb6d51", line-color:"#cb6d51" }
            class-source:{ bg:yellow }
        }

        scene3d(
                    name:"antenna-patch",
                    camera: "isometric-z",
                    draw-contour,
                    real-size:(box_w, box_l, 6mm),
                    real-position:(-13mm, -11mm, -h - h0)
                ){

                    // 1. Ground Plane
                    @(ground) box(
                        size:(box_w, box_l, h0),
                        position:(-13mm, -11mm, -h - h0)
                    )

                    // 2. Substrate
                    @(substrate) box(
                        size:(box_w, box_l, h),
                        position:(-13mm, -11mm, -h)
                    )

                    // 3. Rectangular Patch (No notches)
                    @(antenna) @(patch) box(
                        size:(W, L, h0),
                        position:(-W/2, 0mm, 0mm)
                    )

                    // 4. Quarter-Wave Transformer Section
                    @(antenna) @(transformer) box(
                        size:(wt, Lt, h0),
                        position:(-wt/2, -Lt, 0mm)
                    )

                    // 5. 50-Ohm Feed Line
                    @(antenna) @(feedline) box(
                        size:(wf, Lf, h0),
                        position:(-wf/2, feed_y_start, 0mm)
                    )

                    // 6. Source Port
                    @(source) box(
                        size:(wf, 1mm, h0),
                        position:(-wf/2, port_y_start, 0mm)
                    )

                    // Dimension markers
                    line(from:(-W/2, L + 2mm, 0), to:(W/2, L + 2mm, 0), label:"W")
                    line(from:(-W/2 - 2mm, 0, 0), to:(-W/2 - 2mm, L, 0), label:"L")
                    line(from:(wt/2 + 1.5mm, -Lt, 0), to:(wt/2 + 1.5mm, 0, 0), label:"Lt")
                    line(from:(wf/2 + 1.5mm, feed_y_start, 0), to:(wf/2 + 1.5mm, -Lt, 0), label:"Lf")
                    line(from:(-wf/2, feed_y_start - 1mm, 0), to:(wf/2, feed_y_start - 1mm, 0), label:{text:"wf", offset:(50, -1%P, 0)})
                    line(from:(box_w/2 + 2mm, -11mm, -h), to:(box_w/2 + 2mm, -11mm, 0), label:{text:"h", offset:(50, 1%P, 0)})
        }
    }
}