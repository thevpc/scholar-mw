# openEMS v0.0.36 plus its own Python interface (CSXCAD + openEMS bindings), built from the
# source tree already in the base image, so ports and S-parameters can come from openEMS itself
FROM thevpc/openems:0.0.36
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-dev python3-pip python3-setuptools cython3 python3-numpy python3-h5py python3-matplotlib \
    && rm -rf /var/lib/apt/lists/*
RUN cd /root/openEMS-Project/CSXCAD/python && \
    python3 setup.py build_ext -I/usr/local/include -L/usr/local/lib -R/usr/local/lib && python3 setup.py install
RUN cd /root/openEMS-Project/openEMS/python && \
    python3 setup.py build_ext -I/usr/local/include -L/usr/local/lib -R/usr/local/lib && python3 setup.py install
RUN python3 -c "import CSXCAD, openEMS; from openEMS.ports import MSLPort; print('openEMS python OK')"
CMD ["openEMS", "--help"]
